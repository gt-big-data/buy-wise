# Copy this file to .env and fill in the values.
# .env is gitignored. Never commit real credentials.

# Local MySQL running in Docker (see backend/README.md).
# These match the docker run command in the README, so you can use them as-is.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=buywise

# Only needed to pull price history for products that aren't already in the
# database. The five seeded ASINs work without it, so leave this blank for
# onboarding. Ask a lead before using the real key: we pay monthly and the
# token budget is shared.
KEEPA_API_KEY=
